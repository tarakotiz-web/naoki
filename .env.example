DATABASE_URL="postgresql://postgres:postgres@localhost:5432/node_reservation?schema=public"

# NextAuth
AUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# LINE Messaging API / LIFF
# LINE Developersコンソールで作成したチャネルの値を設定する。
# 未設定のままでもアプリは動作するが、実際のLINE連携(Webhook受信・push送信・LIFFログイン)はスキップ/エラーになる。
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
NEXT_PUBLIC_LINE_LIFF_ID=""

# 前日/当日リマインド送信cron (POST /api/cron/reminders) の認証シークレット。
# 外部スケジューラから `Authorization: Bearer <値>` を付けて1日数回呼び出す。
CRON_SECRET=""

# SORA FOOD PORTAL等の外部システム連携用APIキー(/api/external/v1/* で使用)。
EXTERNAL_API_KEY=""
